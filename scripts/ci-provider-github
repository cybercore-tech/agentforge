#!/usr/bin/env python3
"""Reference AgentForge CI provider for GitHub Actions.

Reads the request from AGENTFORGE_CI_REPOSITORY (owner/name), AGENTFORGE_CI_WORKFLOW (workflow
name or file), and AGENTFORGE_CI_SHA (full commit SHA), queries an authenticated GitHub CLI, and
prints agentforge-ci-v1 protocol on stdout.

When several runs exist for the same workflow and SHA (re-runs or manual dispatches), only the
most recently created run is reported, so AgentForge observes the latest evidence. Failed jobs
carry a bounded excerpt of their failed-step log for classification.

AgentForge runs providers with a cleared environment. The provider profile must pass what `gh`
needs, for example `env.PATH`, `env.HOME`, and either `env.GH_TOKEN` or a `gh auth` login.
"""

import json
import os
import re
import subprocess
import sys

MAX_EXCERPT_CHARS = 2000
MAX_EXCERPT_LINES = 30
SIGNAL = re.compile(
    r"error|panicked|failed|failure|warning|clippy|rustfmt|diff in|assertion|timed out|denied",
    re.IGNORECASE,
)
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
STATUS = {
    "queued": "queued",
    "waiting": "queued",
    "requested": "queued",
    "pending": "queued",
    "in_progress": "in_progress",
    "completed": "completed",
}
CONCLUSION = {
    "success": "success",
    "failure": "failure",
    "startup_failure": "failure",
    "cancelled": "cancelled",
    "skipped": "skipped",
    "timed_out": "timed_out",
    "action_required": "action_required",
    "neutral": "neutral",
    "stale": "neutral",
}


def fail(message):
    print(f"ci-provider-github: {message}", file=sys.stderr)
    sys.exit(1)


def gh(*arguments):
    completed = subprocess.run(
        ["gh", *arguments], capture_output=True, text=True, check=False
    )
    if completed.returncode != 0:
        fail(f"gh {' '.join(arguments[:2])} failed: {completed.stderr.strip()[:500]}")
    return completed.stdout


def clean(value):
    """Protocol fields are tab-separated and must not contain control characters."""
    return "".join(" " if ord(c) < 32 or ord(c) == 127 else c for c in value).strip()


def status_pair(item):
    status = STATUS.get(item.get("status") or "")
    if status is None:
        fail(f"unknown status {item.get('status')!r}")
    if status != "completed":
        return status, "-"
    conclusion = CONCLUSION.get(item.get("conclusion") or "")
    if conclusion is None:
        fail(f"unknown conclusion {item.get('conclusion')!r}")
    return status, conclusion


def excerpt(repository, job_id):
    completed = subprocess.run(
        ["gh", "run", "view", "-R", repository, "--job", str(job_id), "--log-failed"],
        capture_output=True,
        text=True,
        check=False,
    )
    lines = []
    for raw in completed.stdout.splitlines():
        # gh prefixes each line with "<job>\t<step>\t<timestamp> "; keep the message only.
        message = raw.split("\t")[-1]
        message = re.sub(r"^\d{4}-\d\d-\d\dT[\d:.]+Z\s?", "", ANSI.sub("", message))
        message = clean(message)
        if message and SIGNAL.search(message):
            lines.append(message)
    text = " | ".join(lines[-MAX_EXCERPT_LINES:])
    return text[-MAX_EXCERPT_CHARS:]


def main():
    try:
        repository = os.environ["AGENTFORGE_CI_REPOSITORY"]
        workflow = os.environ["AGENTFORGE_CI_WORKFLOW"]
        sha = os.environ["AGENTFORGE_CI_SHA"]
    except KeyError as missing:
        fail(f"missing request variable {missing}")

    runs = json.loads(
        gh(
            "run", "list", "-R", repository, "--workflow", workflow, "--commit", sha,
            "--limit", "50", "--json", "databaseId,headSha,status,conclusion,createdAt",
        )
    )
    print("agentforge-ci-v1")
    if not runs:
        return
    run = max(runs, key=lambda item: item["createdAt"])
    run_id = str(run["databaseId"])
    status, conclusion = status_pair(run)
    print("\t".join(["run", run_id, run["headSha"], status, conclusion]))

    jobs = json.loads(gh("run", "view", run_id, "-R", repository, "--json", "jobs"))["jobs"]
    for job in jobs:
        job_status, job_conclusion = status_pair(job)
        text = excerpt(repository, job["databaseId"]) if job_conclusion == "failure" else ""
        print(
            "\t".join(
                [
                    "job",
                    run_id,
                    str(job["databaseId"]),
                    clean(job["name"]) or "unnamed",
                    job_status,
                    job_conclusion,
                    text,
                ]
            )
        )


if __name__ == "__main__":
    main()
