#!/usr/bin/env bash
# Upload release files to GitHub and verify what was uploaded (P5-M003).
#
# Usage:
#   scripts/publish-release tag <vX.Y.Z> <dir>          publish the release for an existing tag
#   scripts/publish-release rehearse <name> <sha> <dir>  upload to a draft, verify, delete it
#   scripts/publish-release --self-test                  run both modes against a fake gh
#
# <dir> holds exactly the files to release: regular files only, including SHA256SUMS.
#
# Both modes upload through the same `gh release create`, then download every asset back: the set
# of asset names must equal the files in <dir>, each asset must be byte-identical, and SHA256SUMS
# must pass `sha256sum -c`. A rehearsal uploads to a draft release, which creates no tag. The draft
# is always deleted, even when verification fails, and the rehearsal fails if a tag <name> exists
# afterwards. The rehearsal is what a dispatched release run does, so the upload path is proven
# without cutting a release (P5-M002 carried that check forward to the next real tag).
#
# The repository is GITHUB_REPOSITORY (passed to gh as --repo) when set.
#
# With ATTESTATION_SIGNER_WORKFLOW set (`<owner>/<repo>/.github/workflows/<file>`), every downloaded
# archive must also carry a build-provenance attestation signed by that workflow
# (`gh attestation verify`), so the check covers the assets as uploaded (P5-M004). When the release
# also has a CycloneDX SBOM (`*.cdx.json`), every archive must carry an SBOM attestation from that
# workflow too (`--predicate-type https://cyclonedx.org/bom`, P5-M006). Older releases have no SBOM
# and are verified without that check.

set -euo pipefail

fail() {
  echo "publish-release: $*" >&2
  exit 1
}

SBOM_PREDICATE_TYPE=https://cyclonedx.org/bom

repo_args=()
if [ -n "${GITHUB_REPOSITORY:-}" ]; then
  repo_args=(--repo "$GITHUB_REPOSITORY")
fi

# Refuse input that cannot be released as-is: gh cannot upload a directory (the v0.2.0 publish
# failure), and a release without SHA256SUMS cannot be verified.
check_release_dir() {
  local dir="$1" entry count=0
  [ -d "$dir" ] || fail "$dir is not a directory"
  for entry in "$dir"/* "$dir"/.[!.]*; do
    [ -e "$entry" ] || continue
    [ -f "$entry" ] && [ ! -L "$entry" ] || fail "not a regular file: $entry"
    count=$((count + 1))
  done
  [ "$count" -gt 0 ] || fail "$dir is empty"
  [ -f "$dir/SHA256SUMS" ] || fail "$dir has no SHA256SUMS"
}

listing() {
  (cd "$1" && find . -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort)
}

verify() {
  local name="$1" dir="$2" check file count
  check="$(mktemp -d)"
  gh release download "$name" --dir "$check" "${repo_args[@]}" \
    || { rm -rf "$check"; fail "could not download the assets of $name"; }
  if ! diff <(listing "$dir") <(listing "$check") >&2; then
    rm -rf "$check"
    fail "$name: uploaded asset names differ from the release files (< expected, > uploaded)"
  fi
  while IFS= read -r file; do
    cmp -s "$dir/$file" "$check/$file" || { rm -rf "$check"; fail "$name: $file differs after upload"; }
  done < <(listing "$dir")
  (cd "$check" && sha256sum --quiet -c SHA256SUMS) \
    || { rm -rf "$check"; fail "$name: SHA256SUMS does not verify on the downloaded assets"; }
  local checks="names, bytes, SHA256SUMS"
  if [ -n "${ATTESTATION_SIGNER_WORKFLOW:-}" ]; then
    local archive sbom attested=0 sboms=0 has_sbom=0
    for sbom in "$check"/*.cdx.json; do
      if [ -e "$sbom" ]; then has_sbom=1; fi
    done
    for archive in "$check"/*.tar.gz; do
      [ -e "$archive" ] || continue
      gh attestation verify "$archive" "${repo_args[@]}" \
        --signer-workflow "$ATTESTATION_SIGNER_WORKFLOW" > /dev/null \
        || { rm -rf "$check"; fail "$name: $(basename "$archive") has no valid provenance attestation"; }
      attested=$((attested + 1))
      if [ "$has_sbom" = 1 ]; then
        gh attestation verify "$archive" "${repo_args[@]}" --predicate-type "$SBOM_PREDICATE_TYPE" \
          --signer-workflow "$ATTESTATION_SIGNER_WORKFLOW" > /dev/null \
          || { rm -rf "$check"; fail "$name: $(basename "$archive") has no valid SBOM attestation"; }
        sboms=$((sboms + 1))
      fi
    done
    checks="$checks, $attested attestations"
    if [ "$has_sbom" = 1 ]; then
      checks="$checks, $sboms SBOM attestations"
    fi
  fi
  count="$(listing "$check" | wc -l)"
  rm -rf "$check"
  echo "publish-release: verified $count assets of $name ($checks)"
}

tag_exists() {
  local name="$1" output
  if output="$(gh api "repos/${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required to check tags}/git/ref/tags/$name" 2>&1)"; then
    return 0
  fi
  case "$output" in
    *"HTTP 404"*) return 1 ;;
    *) fail "could not check for tag $name: $output" ;;
  esac
}

publish_tag() {
  local tag="$1" dir="$2"
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "not a release tag: $tag"
  check_release_dir "$dir"
  gh release create "$tag" "$dir"/* "${repo_args[@]}" --verify-tag --generate-notes \
    --title "AgentForge $tag"
  verify "$tag" "$dir"
}

rehearsal_name=""
rehearsal_cleanup() {
  local status=$?
  trap - EXIT
  if [ -n "$rehearsal_name" ]; then
    if gh release delete "$rehearsal_name" --yes "${repo_args[@]}"; then
      echo "publish-release: deleted draft $rehearsal_name"
    else
      echo "publish-release: could not delete draft $rehearsal_name; delete it by hand" >&2
      status=1
    fi
    if tag_exists "$rehearsal_name"; then
      echo "publish-release: tag $rehearsal_name exists after the rehearsal; delete it by hand" >&2
      status=1
    fi
  fi
  exit "$status"
}

rehearse() {
  local name="$1" sha="$2" dir="$3"
  [[ "$name" =~ ^rehearsal-[A-Za-z0-9.-]+$ ]] || fail "a rehearsal name must start with rehearsal-: $name"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "not a full commit SHA: $sha"
  check_release_dir "$dir"
  tag_exists "$name" && fail "tag $name already exists; refusing to rehearse over it"
  trap rehearsal_cleanup EXIT
  rehearsal_name="$name"
  gh release create "$name" "$dir"/* "${repo_args[@]}" --draft --target "$sha" \
    --title "AgentForge release rehearsal $name" \
    --notes "Upload rehearsal from a dispatched release run. Deleted automatically."
  verify "$name" "$dir"
  echo "publish-release: rehearsal $name passed"
}

# A fake gh that keeps releases and tags in $FAKE_GH_STATE. FAKE_GH_DROP and FAKE_GH_CORRUPT name
# an asset to lose or damage on upload; FAKE_GH_LEAK_TAG=1 makes a draft create a tag anyway.
# Uploaded archives count as attested (by their original digest) unless named by FAKE_GH_UNATTESTED.
# When the upload includes a *.cdx.json, its archives also count as SBOM-attested unless named by
# FAKE_GH_SBOM_UNATTESTED. `attestation verify --predicate-type https://cyclonedx.org/bom` checks
# those; any other predicate type is refused.
write_fake_gh() {
  cat > "$1/gh" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
state="${FAKE_GH_STATE:?}"
mkdir -p "$state/releases" "$state/tags"
command="$1 ${2:-}"
shift 2 || true
positional=() ; draft=0 ; verify_tag=0 ; dir="" ; predicate=""
while [ $# -gt 0 ]; do
  case "$1" in
    --draft) draft=1 ;;
    --verify-tag) verify_tag=1 ;;
    --generate-notes|--yes) ;;
    --repo|--target|--title|--notes|--signer-workflow) shift ;;
    --dir) dir="$2"; shift ;;
    --predicate-type) predicate="$2"; shift ;;
    *) positional+=("$1") ;;
  esac
  shift
done
name="${positional[0]:-}"
case "$command" in
  "release create")
    [ ! -e "$state/releases/$name" ] || { echo "release $name exists" >&2; exit 1; }
    if [ "$verify_tag" = 1 ] && [ ! -e "$state/tags/$name" ]; then
      echo "tag $name doesn't exist in the repo" >&2; exit 1
    fi
    mkdir "$state/releases/$name"
    with_sbom=0
    for file in "${positional[@]:1}"; do
      if [[ "$file" == *.cdx.json ]]; then with_sbom=1; fi
    done
    for file in "${positional[@]:1}"; do
      [ -f "$file" ] || { echo "read $file: is a directory" >&2; exit 1; }
      base="$(basename "$file")"
      if [[ "$base" == *.tar.gz ]] && [ "$base" != "${FAKE_GH_UNATTESTED:-}" ]; then
        sha256sum "$file" | cut -d' ' -f1 >> "$state/attested"
      fi
      if [[ "$base" == *.tar.gz ]] && [ "$with_sbom" = 1 ] \
        && [ "$base" != "${FAKE_GH_SBOM_UNATTESTED:-}" ]; then
        sha256sum "$file" | cut -d' ' -f1 >> "$state/sbom-attested"
      fi
      [ "$base" = "${FAKE_GH_DROP:-}" ] && continue
      cp "$file" "$state/releases/$name/$base"
      [ "$base" = "${FAKE_GH_CORRUPT:-}" ] && printf 'x' >> "$state/releases/$name/$base"
    done
    if [ "$draft" = 0 ] || [ "${FAKE_GH_LEAK_TAG:-0}" = 1 ]; then touch "$state/tags/$name"; fi
    ;;
  "release download")
    [ -d "$state/releases/$name" ] || { echo "release not found" >&2; exit 1; }
    cp "$state/releases/$name"/* "$dir"/
    ;;
  "release delete")
    [ -d "$state/releases/$name" ] || { echo "release not found" >&2; exit 1; }
    rm -rf "$state/releases/$name"
    ;;
  "attestation verify")
    case "$predicate" in
      "") store="$state/attested" ;;
      https://cyclonedx.org/bom) store="$state/sbom-attested" ;;
      *) echo "fake gh: unsupported predicate type: $predicate" >&2; exit 2 ;;
    esac
    digest="$(sha256sum "$name" | cut -d' ' -f1)"
    grep -qx "$digest" "$store" 2>/dev/null \
      || { echo "Error: no attestations found for $name" >&2; exit 1; }
    ;;
  "api "*)
    ref="${command#api }"
    [ -e "$state/tags/${ref##*/}" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
    echo '{"ref":"refs/tags/'"${ref##*/}"'"}'
    ;;
  *) echo "fake gh: unsupported: $command" >&2; exit 2 ;;
esac
FAKE
  chmod +x "$1/gh"
}

self_test() {
  local script failures=0
  script="$(realpath "$0")"
  self_test_work="$(mktemp -d)"
  trap 'rm -rf "$self_test_work"' EXIT
  local work="$self_test_work"
  mkdir "$work/bin" "$work/files"
  write_fake_gh "$work/bin"
  for target in x86_64-unknown-linux-gnu aarch64-apple-darwin; do
    printf 'archive %s\n' "$target" > "$work/files/agentforge-9.9.9-$target.tar.gz"
    (cd "$work/files" && sha256sum "agentforge-9.9.9-$target.tar.gz" > "agentforge-9.9.9-$target.tar.gz.sha256")
  done
  (cd "$work/files" && sha256sum -- *.tar.gz > SHA256SUMS)

  local sha
  sha="$(printf '%040d' 0 | tr 0 a)"

  # expect <description> <want> <env...> -- <args...>
  # <want> is "pass", or text the failure output must contain, so a case cannot fail for the
  # wrong reason.
  expect() {
    local description="$1" want="$2" state output status
    shift 2
    local env=()
    while [ "$1" != "--" ]; do env+=("$1"); shift; done
    shift
    state="$work/state-$RANDOM$RANDOM"
    mkdir -p "$state/tags"
    [ "${PRE_TAG:-}" ] && touch "$state/tags/$PRE_TAG"
    set +e
    output="$(env PATH="$work/bin:$PATH" FAKE_GH_STATE="$state" GITHUB_REPOSITORY=test/repo \
      "${env[@]}" "$script" "$@" 2>&1)"
    status=$?
    set -e
    LAST_STATE="$state"
    LAST_OUTPUT="$output"
    if { [ "$want" = pass ] && [ "$status" -eq 0 ]; } \
      || { [ "$want" != pass ] && [ "$status" -ne 0 ] && [[ "$output" == *"$want"* ]]; }; then
      echo "ok   $description"
    else
      echo "FAIL $description (exit $status)"
      printf '%s\n' "$output" | sed 's/^/     /'
      failures=$((failures + 1))
    fi
  }

  # no_leftovers <description>: the last rehearsal left neither a release nor a tag behind.
  no_leftovers() {
    if [ -z "$(ls -A "$LAST_STATE/releases" 2>/dev/null)" ] && [ -z "$(ls -A "$LAST_STATE/tags")" ]; then
      echo "ok   $1"
    else
      echo "FAIL $1: $(ls "$LAST_STATE/releases" "$LAST_STATE/tags" 2>&1 | tr '\n' ' ')"
      failures=$((failures + 1))
    fi
  }

  PRE_TAG=v9.9.9 expect "tag: publishes and verifies" pass -- tag v9.9.9 "$work/files"
  [ -f "$LAST_STATE/releases/v9.9.9/SHA256SUMS" ] && echo "ok   tag: release holds the files" \
    || { echo "FAIL tag: release holds the files"; failures=$((failures + 1)); }
  expect "tag: refuses a missing tag (--verify-tag)" "doesn't exist" -- tag v9.9.9 "$work/files"
  PRE_TAG=v9.9.9 expect "tag: a corrupted asset fails verification" "SHA256SUMS differs after upload" FAKE_GH_CORRUPT=SHA256SUMS -- tag v9.9.9 "$work/files"
  PRE_TAG=v9.9.9 expect "tag: a dropped asset fails verification" "asset names differ" \
    FAKE_GH_DROP=agentforge-9.9.9-aarch64-apple-darwin.tar.gz -- tag v9.9.9 "$work/files"
  expect "tag: refuses a non-release tag name" "not a release tag" -- tag milestone/P5-M003 "$work/files"

  expect "rehearse: uploads, verifies, deletes" pass -- rehearse rehearsal-1-1 "$sha" "$work/files"
  no_leftovers "rehearse: no draft or tag left"
  expect "rehearse: a dropped asset fails" "asset names differ" \
    FAKE_GH_DROP=agentforge-9.9.9-x86_64-unknown-linux-gnu.tar.gz.sha256 -- rehearse rehearsal-1-2 "$sha" "$work/files"
  no_leftovers "rehearse: the failed draft is still deleted"
  expect "rehearse: a corrupted asset fails" "tar.gz differs after upload" \
    FAKE_GH_CORRUPT=agentforge-9.9.9-x86_64-unknown-linux-gnu.tar.gz -- rehearse rehearsal-1-3 "$sha" "$work/files"
  no_leftovers "rehearse: the corrupted draft is still deleted"
  expect "rehearse: a leaked tag fails the rehearsal" "exists after the rehearsal" FAKE_GH_LEAK_TAG=1 -- rehearse rehearsal-1-4 "$sha" "$work/files"
  PRE_TAG=rehearsal-1-5 expect "rehearse: refuses an existing tag" "already exists" -- rehearse rehearsal-1-5 "$sha" "$work/files"
  expect "rehearse: refuses a name outside rehearsal-*" "must start with rehearsal-" -- rehearse v9.9.9 "$sha" "$work/files"
  expect "rehearse: refuses a short SHA" "not a full commit SHA" -- rehearse rehearsal-1-6 abc123 "$work/files"

  mkdir "$work/with-dir" && cp "$work/files"/* "$work/with-dir/" && mkdir "$work/with-dir/agentforge-9.9.9-staging"
  PRE_TAG=v9.9.9 expect "input: a staging directory is refused (the v0.2.0 failure)" "not a regular file" -- tag v9.9.9 "$work/with-dir"
  mkdir "$work/stale-sums" && cp "$work/files"/* "$work/stale-sums/"
  printf 'rebuilt\n' >> "$work/stale-sums/agentforge-9.9.9-aarch64-apple-darwin.tar.gz"
  expect "input: a stale SHA256SUMS fails verification" "SHA256SUMS does not verify" \
    -- rehearse rehearsal-1-8 "$sha" "$work/stale-sums"
  no_leftovers "rehearse: the stale-checksum draft is still deleted"
  PRE_TAG=v9.9.9 expect "attestations: attested archives pass" pass \
    ATTESTATION_SIGNER_WORKFLOW=test/repo/.github/workflows/release.yml -- tag v9.9.9 "$work/files"
  # The fake records no SBOM attestations for an upload without *.cdx.json, so checking one fails.
  [[ "$LAST_OUTPUT" == *"2 attestations)"* ]] \
    && echo "ok   sbom: a release without an SBOM is verified without the SBOM check" \
    || { echo "FAIL sbom: a release without an SBOM is verified without the SBOM check: $LAST_OUTPUT"; failures=$((failures + 1)); }
  expect "attestations: an unattested archive fails the rehearsal" "has no valid provenance attestation" \
    ATTESTATION_SIGNER_WORKFLOW=test/repo/.github/workflows/release.yml \
    FAKE_GH_UNATTESTED=agentforge-9.9.9-aarch64-apple-darwin.tar.gz -- rehearse rehearsal-1-9 "$sha" "$work/files"
  no_leftovers "attestations: the unattested draft is still deleted"
  expect "attestations: not checked without a signer workflow" pass \
    FAKE_GH_UNATTESTED=agentforge-9.9.9-aarch64-apple-darwin.tar.gz -- rehearse rehearsal-1-10 "$sha" "$work/files"

  mkdir "$work/with-sbom" && cp "$work/files"/*.tar.gz* "$work/with-sbom/"
  printf '{"bomFormat":"CycloneDX","specVersion":"1.5"}\n' > "$work/with-sbom/agentforge-9.9.9.cdx.json"
  (cd "$work/with-sbom" && sha256sum -- *.tar.gz *.cdx.json > SHA256SUMS)
  PRE_TAG=v9.9.9 expect "sbom: SBOM-attested archives pass" pass \
    ATTESTATION_SIGNER_WORKFLOW=test/repo/.github/workflows/release.yml -- tag v9.9.9 "$work/with-sbom"
  [[ "$LAST_OUTPUT" == *"2 attestations, 2 SBOM attestations"* ]] \
    && echo "ok   sbom: every archive's SBOM attestation is checked" \
    || { echo "FAIL sbom: every archive's SBOM attestation is checked: $LAST_OUTPUT"; failures=$((failures + 1)); }
  expect "sbom: an archive without an SBOM attestation fails the rehearsal" "has no valid SBOM attestation" \
    ATTESTATION_SIGNER_WORKFLOW=test/repo/.github/workflows/release.yml \
    FAKE_GH_SBOM_UNATTESTED=agentforge-9.9.9-x86_64-unknown-linux-gnu.tar.gz \
    -- rehearse rehearsal-1-11 "$sha" "$work/with-sbom"
  no_leftovers "sbom: the draft without an SBOM attestation is still deleted"
  expect "sbom: provenance is still required with an SBOM" "has no valid provenance attestation" \
    ATTESTATION_SIGNER_WORKFLOW=test/repo/.github/workflows/release.yml \
    FAKE_GH_UNATTESTED=agentforge-9.9.9-aarch64-apple-darwin.tar.gz -- rehearse rehearsal-1-12 "$sha" "$work/with-sbom"
  expect "sbom: not checked without a signer workflow" pass \
    FAKE_GH_SBOM_UNATTESTED=agentforge-9.9.9-x86_64-unknown-linux-gnu.tar.gz \
    -- rehearse rehearsal-1-13 "$sha" "$work/with-sbom"
  mkdir "$work/no-sums" && cp "$work/files"/*.tar.gz* "$work/no-sums/"
  expect "input: missing SHA256SUMS is refused" "has no SHA256SUMS" -- rehearse rehearsal-1-7 "$sha" "$work/no-sums"

  if [ "$failures" -ne 0 ]; then
    echo "publish-release self-test: $failures failure(s)" >&2
    exit 1
  fi
  echo "publish-release self-test passed"
}

case "${1:-}" in
  tag) [ $# -eq 3 ] || fail "usage: publish-release tag <vX.Y.Z> <dir>"; publish_tag "$2" "$3" ;;
  rehearse) [ $# -eq 4 ] || fail "usage: publish-release rehearse <name> <sha> <dir>"; rehearse "$2" "$3" "$4" ;;
  --self-test) self_test ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
