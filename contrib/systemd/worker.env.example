# Environment for agentforge-worker@<id>.service (P4-M010). Install as
# ~/.config/agentforge/worker-<id>.env with mode 600. The worker ID is the unit instance name.

# The coordinator's worker API through the local GhostPort listener (loopback only).
AGENTFORGE_ENDPOINT=127.0.0.1:47300

# The secret written by `forge worker enroll` on the coordinator, copied here at mode 600.
AGENTFORGE_SECRET_FILE=/home/you/.config/agentforge/worker-<id>.secret

# The worker host's clone of the project (a real clone with an origin, hooks installed).
AGENTFORGE_REPO=/home/you/src/project

# An agent profile in that clone (.forge/agents/<name>.conf). Its paths must point inside the
# clone; `forge worker remote doctor` warns otherwise.
AGENTFORGE_PROFILE=claude-code

# The user manager's PATH is minimal. Set it when git, ssh, or the agent need more.
# PATH=/home/you/.local/bin:/usr/local/bin:/usr/bin
